{
  "permissions": {
    "allow": [
      "Bash(Get-ChildItem *)",
      "PowerShell(Get-ChildItem -Force | Select-Object Name, @{Name=\"Type\"; Expression={if\\($_.PSIsContainer\\){\"Directory\"}else{\"File\"}}}, Length)",
      "PowerShell(head *)",
      "Bash(git init *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git remote *)"
    ]
  }
}
